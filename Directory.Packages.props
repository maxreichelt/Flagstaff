<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Runtime / WinUI -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- tools/ManifestGen only: Windows.Foundation.UniversalApiContract.winmd for enums WinUI properties use from
         Windows.* (VirtualKey, VirtualKeyModifiers, ...). Matches the WindowsAppSDK's minimum SDK. -->
    <PackageVersion Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.22621.57" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- Flagstaff's own build package, consumed by samples/TaskTrack with /p:FlagstaffFromPackage=true
       (restored from artifacts/packages via samples/nuget.config). Tracks the repo version; a
       global /p:Version=... overrides it. -->
  <PropertyGroup>
    <FlagstaffPackageVersion Condition="'$(Version)' != ''">$(Version)</FlagstaffPackageVersion>
    <FlagstaffPackageVersion Condition="'$(FlagstaffPackageVersion)' == '' And '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</FlagstaffPackageVersion>
    <FlagstaffPackageVersion Condition="'$(FlagstaffPackageVersion)' == ''">$(VersionPrefix)</FlagstaffPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Flagstaff" Version="$(FlagstaffPackageVersion)" />
  </ItemGroup>

  <!-- CLI -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <!-- Syntax-only scan of the hand-written C# partials (members the generator then skips). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
  </ItemGroup>

</Project>
