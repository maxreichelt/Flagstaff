<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flagstaff.Compiler</RootNamespace>
  </PropertyGroup>

  <!-- Control manifest (tools/ManifestGen output; .json or .json.gz) and its hand-curated overlay.
       Logical names are the bare file names; ControlManifest.Default loads them. -->
  <ItemGroup>
    <EmbeddedResource Include="Manifest\winui-manifest.json*" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Manifest\overlay.json" LogicalName="overlay.json" />
  </ItemGroup>

</Project>
