<!-- Flagstaff.Stdlib default styles for WinUI 3 -->
<!-- Generated XAML references these via StaticResource -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Accent defaults (overridden by app theme block) ── -->
    <Color x:Key="FlagstaffAccentColor">#0078D4</Color>
    <SolidColorBrush x:Key="FlagstaffAccentBrush" Color="{StaticResource FlagstaffAccentColor}" />

    <!-- ── Card ── -->
    <Style x:Key="FlagstaffCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ── Stat Card ── -->
    <Style x:Key="FlagstaffStatCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FlagstaffAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── Toolbar ── -->
    <Style x:Key="FlagstaffToolbar" TargetType="Grid">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- ── Table Header ── -->
    <Style x:Key="FlagstaffTableHeader" TargetType="Grid">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- region: tables -->
    <!-- Row grid of a table; same padding as FlagstaffTableHeader so cells line up with the header. -->
    <Style x:Key="FlagstaffTableRow" TargetType="Grid">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Table row container: no padding/min-height of its own, so the row grid alone defines the layout. -->
    <Style x:Key="FlagstaffTableItemContainer" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- list row container: rows stretch to the list width. -->
    <Style x:Key="FlagstaffListItemContainer" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- empty "No rows yet."; under a table/list -->
    <Style x:Key="FlagstaffEmptyState" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- endregion: tables -->

    <!-- ── File Picker Button ── -->
    <Style x:Key="FlagstaffFilePickerButton" TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ── Dialog Overlay ── -->
    <Style x:Key="FlagstaffDialogOverlay" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- region: overlays -->
    <!-- Modal backdrop for dialog / confirm (hoisted into the page's FlagstaffOverlay layer). -->
    <Style x:Key="FlagstaffDialogBackdrop" TargetType="Border">
        <Setter Property="Background" Value="#80000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Centered dialog card. -->
    <Style x:Key="FlagstaffDialogCard" TargetType="Border" BasedOn="{StaticResource FlagstaffCard}">
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="24" />
    </Style>
    <!-- endregion: overlays -->
    <!-- region: layout -->
    <!-- ── Danger Button (button variant: danger) ── -->
    <Style x:Key="FlagstaffDangerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- ── Stat card variants (stat variant: success|warning|danger|info) ── -->
    <Style x:Key="FlagstaffStatCardSuccess" TargetType="Border" BasedOn="{StaticResource FlagstaffStatCard}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="FlagstaffStatCardWarning" TargetType="Border" BasedOn="{StaticResource FlagstaffStatCard}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="FlagstaffStatCardDanger" TargetType="Border" BasedOn="{StaticResource FlagstaffStatCard}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="FlagstaffStatCardInfo" TargetType="Border" BasedOn="{StaticResource FlagstaffStatCard}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorAttentionBrush}" />
    </Style>
    <!-- endregion: layout -->

    <!-- ── Converters ── -->
    <!-- BoolToVisibility and format converters should be registered by consuming apps.
         When using when() with comparison operators (e.g. when(vm.X > 0)), the generated
         XAML uses x:Bind function calls to local:Converters helper methods. Consuming apps
         should provide a static Converters class with methods like IsPositive(int) that
         return Visibility. -->

</ResourceDictionary>
