<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for samples. Used when a sample is built with /p:FlagstaffFromPackage=true:
  the Flagstaff packages come from the local artifact feed (dotnet pack ... -o artifacts/packages),
  everything else from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="flagstaff-artifacts" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="flagstaff-artifacts">
      <package pattern="Flagstaff" />
      <package pattern="Flagstaff.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
