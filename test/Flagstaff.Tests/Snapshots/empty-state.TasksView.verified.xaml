<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="EmptyApp.TasksView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmptyApp"
    xmlns:vm="using:EmptyApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffTableItemContainer}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource FlagstaffTableHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Due" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskItem">
                                <Grid Style="{StaticResource FlagstaffTableRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Due, Converter={StaticResource DateConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="No tasks yet." Style="{StaticResource FlagstaffEmptyState}" Grid.Row="1" Visibility="{x:Bind local:Converters.IsZero(ViewModel.Tasks.Count), Mode=OneWay}" />
                </Grid>
                <Grid Visibility="{x:Bind ViewModel.ShowNotes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:Note">
                                <StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{x:Bind Body}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Row="1" Visibility="{x:Bind local:TasksView.When_1(ViewModel.IsLoading), Mode=OneWay}">
                        <TextBlock Text="Nothing noted." Style="{StaticResource FlagstaffEmptyState}" Visibility="{x:Bind local:Converters.IsZero(ViewModel.Notes.Count), Mode=OneWay}" />
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
