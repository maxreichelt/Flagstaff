<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="FormApp.EntryView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FormApp"
    xmlns:vm="using:FormApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock Text="New Entry" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <TextBox Header="Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Border Grid.Column="1">
                        <NumberBox Header="Amount" Value="{x:Bind ViewModel.Amount, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                    </Border>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <ComboBox Header="Year" SelectedItem="{x:Bind ViewModel.Year, Mode=TwoWay}">
                            <x:Int32>2019</x:Int32>
                            <x:Int32>2020</x:Int32>
                            <x:Int32>2021</x:Int32>
                            <x:Int32>2022</x:Int32>
                            <x:Int32>2023</x:Int32>
                            <x:Int32>2024</x:Int32>
                            <x:Int32>2025</x:Int32>
                            <x:Int32>2026</x:Int32>
                        </ComboBox>
                    </Border>
                    <Border Grid.Column="1">
                        <ComboBox Header="Category" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" />
                    </Border>
                    <Border Grid.Column="2">
                        <CalendarDatePicker Header="Due" Date="{x:Bind ViewModel.DueDate, Mode=TwoWay}" />
                    </Border>
                </Grid>
                <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                <StackPanel Spacing="8">
                    <CheckBox Content="Billable" IsChecked="{x:Bind ViewModel.IsBillable, Mode=TwoWay}" />
                    <RadioButton Content="Personal" IsChecked="{x:Bind ViewModel.IsPersonal, Mode=TwoWay}" />
                    <RadioButton Content="Business" IsChecked="{x:Bind ViewModel.IsBusiness, Mode=TwoWay}" />
                    <ToggleSwitch Header="Notify me" IsOn="{x:Bind ViewModel.Notify, Mode=TwoWay}" />
                </StackPanel>
                <Button Content="Attach receipt" Style="{StaticResource FlagstaffFilePickerButton}" Command="{x:Bind ViewModel.AttachCommand, Mode=OneWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" />
                    </Border>
                    <Border Grid.Column="1">
                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" />
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
