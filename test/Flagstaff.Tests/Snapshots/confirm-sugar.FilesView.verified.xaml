<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="ConfirmApp.FilesView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConfirmApp"
    xmlns:vm="using:ConfirmApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Button Content="Delete file" Command="{x:Bind ViewModel.RequestDeleteCommand, Mode=OneWay}" />
                <Button Content="Discard" Command="{x:Bind ViewModel.RequestDiscardCommand, Mode=OneWay}" />
                <!-- confirm "Delete file?": rendered in FlagstaffOverlay -->
                <!-- confirm "Discard changes?": rendered in FlagstaffOverlay -->
                <!-- confirm "Move file": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsDeleteVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Delete file?" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="This cannot be undone." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Delete" Style="{StaticResource FlagstaffDangerButton}" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelIsDeleteVisibleCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.IsDiscardVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Discard changes?" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="OK" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DiscardCommand, Mode=OneWay}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelIsDiscardVisibleCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.IsMoveVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Move file" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Pick a destination." TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <TextBox Header="Destination" Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Move" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.MoveCommand, Mode=OneWay}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelIsMoveVisibleCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
