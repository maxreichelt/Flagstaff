<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="StatesApp.ShellView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StatesApp"
    xmlns:vm="using:StatesApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Nav.DisplayMode" Value="Inline" />
                        <Setter Target="Nav.IsPaneOpen" Value="True" />
                        <Setter Target="Summary.Padding" Value="24,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <SplitView DisplayMode="Overlay" OpenPaneLength="280" x:Name="Nav">
                    <SplitView.Pane>
                        <StackPanel Padding="12">
                            <Button Content="Inbox" Command="{x:Bind ViewModel.InboxCommand, Mode=OneWay}" />
                        </StackPanel>
                    </SplitView.Pane>
                    <Border Style="{StaticResource FlagstaffCard}" x:Name="Summary">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Summary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Ready" />
                        </StackPanel>
                    </Border>
                </SplitView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
