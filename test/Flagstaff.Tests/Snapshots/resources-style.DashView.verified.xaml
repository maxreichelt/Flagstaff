<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="StyleApp.DashView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StyleApp"
    xmlns:vm="using:StyleApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Page.Resources>
        <Style x:Key="CompactStat" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="CompactStatWide" TargetType="Border" BasedOn="{StaticResource CompactStat}">
            <Setter Property="MinWidth" Value="240" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <SolidColorBrush x:Key="Accent" Color="#2563eb" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Border Style="{StaticResource CompactStat}">
                    <StackPanel Spacing="4" Padding="16">
                        <TextBlock Text="Total" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CompactStatWide}">
                    <StackPanel Spacing="4" Padding="16">
                        <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Open, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Accent}" BorderThickness="1">
                    <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
