<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="ValuesApp.DetailsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ValuesApp"
    xmlns:vm="using:ValuesApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Page.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563eb" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource Accent}" x:Name="FlagstaffLoad_1" x:Uid="DetailsPane" x:Load="{x:Bind ViewModel.ShowDetails, Mode=OneWay}">
                    <TextBlock Text="Details" />
                </Border>
                <Border Background="Red" BorderBrush="#ff0000" BorderThickness="2" />
                <Rectangle Fill="CornflowerBlue" Stroke="#80000000" Height="8" />
                <Border Style="{StaticResource FlagstaffCard}" x:Name="FlagstaffLoad_2" x:Uid="LazyCard" x:Load="{x:Bind ViewModel.ShowCard, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Lazy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Loaded on demand" />
                    </StackPanel>
                </Border>
                <Button Content="Menu">
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock Text="Saved" />
                            <!-- toast "Hi": rendered in FlagstaffOverlay -->
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.ShowToast, Mode=TwoWay}" Severity="Informational" Message="Hi" IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
