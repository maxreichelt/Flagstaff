<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="MarginApp.FormView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarginApp"
    xmlns:vm="using:MarginApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" MaxLength="80" />
                <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="Notes" AutomationProperties.HelpText="Free text" />
                <ToggleSwitch Header="Active" IsOn="{x:Bind ViewModel.IsActive, Mode=TwoWay}" Margin="8" />
                <TextBlock Text="Hint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Border Style="{StaticResource FlagstaffCard}" Padding="24" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="16" ToolTipService.Placement="Bottom">
                    <CheckBox Content="Agree" IsChecked="{x:Bind ViewModel.Agree, Mode=TwoWay}" IsThreeState="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
