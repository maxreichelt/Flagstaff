<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="FlyoutApp.ItemsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlyoutApp"
    xmlns:vm="using:FlyoutApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Button Content="More" Margin="0,8,0,0" AutomationProperties.Name="More actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Duplicate" Command="{x:Bind ViewModel.DuplicateCommand, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Archive" Command="{x:Bind ViewModel.ArchiveCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanArchive, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Save as" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
