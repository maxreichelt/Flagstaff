<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="TaskTrack.DashboardView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTrack"
    xmlns:vm="using:TaskTrack.ViewModels"
    Loaded="OnViewLoaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Page.Resources>
        <Style x:Key="TightCard" TargetType="Border" BasedOn="{StaticResource FlagstaffCard}">
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpNext.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Home" />
                    <TextBlock Text="Dashboard" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ComboBox Header="Project" SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ProjectNames, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" RowSpacing="12" Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0">
                            <Border Style="{StaticResource FlagstaffStatCardInfo}">
                                <StackPanel Spacing="4" Padding="16">
                                    <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.OpenCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0">
                            <Border Style="{StaticResource FlagstaffStatCardWarning}">
                                <StackPanel Spacing="4" Padding="16">
                                    <TextBlock Text="In Progress" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="0">
                            <Border Style="{StaticResource FlagstaffStatCardSuccess}">
                                <StackPanel Spacing="4" Padding="16">
                                    <TextBlock Text="Done" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="0">
                            <Border Style="{StaticResource FlagstaffStatCardDanger}" Visibility="{x:Bind local:DashboardView.When_1(ViewModel.OverdueCount, ViewModel.IsLoading), Mode=OneWay}">
                                <StackPanel Spacing="4" Padding="16">
                                    <TextBlock Text="Overdue" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.OverdueCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                            <Border Style="{StaticResource FlagstaffCard}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="People" />
                                        <TextBlock Text="Workload" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total tasks" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Estimated hours" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalEstimate, Mode=OneWay, Converter={StaticResource NumberConverter}}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Remaining hours" FontWeight="Bold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RemainingEstimate, Mode=OneWay, Converter={StaticResource NumberConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1">
                            <Border Style="{StaticResource FlagstaffCard}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Accept" />
                                        <TextBlock Text="Progress" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Completion" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CompletionRate, Mode=OneWay, Converter={StaticResource PercentConverter}}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="High priority open" FontWeight="Bold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HighPriorityOpen, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                    <Border x:Name="UpNext" Width="240" Style="{StaticResource TightCard}" Grid.Row="0" Grid.Column="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Calendar" />
                                <TextBlock Text="Up next" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Next due" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextDue, Mode=OneWay, Converter={StaticResource DateConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Task" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextDueTitle, Mode=OneWay}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <InfoBar IsOpen="True" Severity="Warning" Message="Some tasks are past their due date." Visibility="{x:Bind local:DashboardView.When_2(ViewModel.OverdueCount, ViewModel.IsLoading), Mode=OneWay}">
                    <Button Content="Review tasks" Tag="TasksView" Click="OnNavigateButtonClick" />
                </InfoBar>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
