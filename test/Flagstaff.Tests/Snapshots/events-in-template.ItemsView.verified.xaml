<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="EventsApp.ItemsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EventsApp"
    xmlns:vm="using:EventsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                            <StackPanel Spacing="4" Padding="0,8">
                                <Border Style="{StaticResource FlagstaffCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Content="Open" Click="OnEvent_1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffTableItemContainer}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource FlagstaffTableHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Number" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="Archive" Opacity="0" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Order">
                            <Grid Style="{StaticResource FlagstaffTableRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Number}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="Archive" Click="OnEvent_2" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
