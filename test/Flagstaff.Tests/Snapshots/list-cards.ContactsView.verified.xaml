<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="CardsApp.ContactsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CardsApp"
    xmlns:vm="using:CardsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ListView ItemsSource="{x:Bind ViewModel.Contacts, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedContact, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="OnItemClick_1" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Contact">
                            <StackPanel Spacing="4" Padding="0,8">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Email}" />
                                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{x:Bind IsVip, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Bind Tier}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <CheckBox Content="Active" IsChecked="{x:Bind IsActive, Mode=TwoWay}" />
                                <Button Content="Call" Command="{Binding ElementName=FlagstaffPage, Path=ViewModel.CallCommand}" CommandParameter="{x:Bind}" IsEnabled="{x:Bind HasPhone}" />
                                <Button Content="Details" Tag="ContactDetailView" Click="OnNavigateButtonClick" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
