<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="EventsApp.PlayerView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EventsApp"
    xmlns:vm="using:EventsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Slider Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Minimum="0" Maximum="100" ValueChanged="OnEvent_1" />
                <TextBox Text="{x:Bind ViewModel.Query, Mode=TwoWay}" TextChanged="OnEvent_2" />
                <Border Padding="12" Tapped="OnEvent_3">
                    <TextBlock Text="Open details" />
                </Border>
                <Border Style="{StaticResource FlagstaffCard}" PointerEntered="OnEvent_4" PointerExited="OnEvent_5">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Hover me" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="A card with pointer handlers" />
                    </StackPanel>
                </Border>
                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" Click="OnEvent_6" />
                <!-- dialog "Edit": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Edit" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnEvent_7" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Close" Command="{x:Bind ViewModel.CancelIsEditingCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
