<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="CardsApp.StatsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CardsApp"
    xmlns:vm="using:CardsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCard}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OpenCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardWarning}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Pending" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardDanger}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Overdue" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OverdueCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="1">
                        <Border Style="{StaticResource FlagstaffStatCardSuccess}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Done" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="1">
                        <Border Style="{StaticResource FlagstaffStatCardInfo}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Info" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.InfoCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2">
                        <Border Style="{StaticResource FlagstaffCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Trend" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TrendText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
