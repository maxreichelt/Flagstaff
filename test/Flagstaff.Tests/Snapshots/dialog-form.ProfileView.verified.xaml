<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="DialogApp.ProfileView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DialogApp"
    xmlns:vm="using:DialogApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="Profile" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                <Button Content="Edit" Command="{x:Bind ViewModel.OpenEditCommand, Mode=OneWay}" />
                <!-- dialog "Edit profile": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsEditOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Edit profile" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Changes apply immediately." TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Tell us who you are." TextWrapping="Wrap" />
                            <TextBox Header="Name" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <NumberBox Header="Age" Value="{x:Bind ViewModel.Age, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                            <CheckBox Content="Subscribe to updates" IsChecked="{x:Bind ViewModel.Subscribe, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand, Mode=OneWay}" />
                            <Button Content="Save" Command="{x:Bind ViewModel.SaveProfileCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
