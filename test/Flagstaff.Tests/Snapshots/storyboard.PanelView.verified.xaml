<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="AnimApp.PanelView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AnimApp"
    xmlns:vm="using:AnimApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Page.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
        </Storyboard>
        <Storyboard x:Key="Pulse" Storyboard.TargetName="Panel">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" To="0.5" Duration="0:0:0.15" AutoReverse="True" />
        </Storyboard>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Button Content="Fade" Command="{x:Bind ViewModel.FadeCommand, Mode=OneWay}" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" x:Name="Panel">
                    <TextBlock Text="Animated panel" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
