<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="EscapeApp.ProfileView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EscapeApp"
    xmlns:vm="using:EscapeApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <StackPanel Spacing="8">
                            <Image Source="{x:Bind ViewModel.AvatarUrl, Mode=OneWay}" Stretch="Uniform" />
                            <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource FlagstaffStatCard}">
                                <StackPanel Spacing="4" Padding="16">
                                    <TextBlock Text="Messages" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.MessageCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.MessageCount, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <ProgressBar Value="{x:Bind ViewModel.Completion, Mode=OneWay}" />
                            <ProgressRing IsActive="True" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Admin" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Administrative tools" />
                    <Button Content="Reset" Command="{x:Bind ViewModel.ResetCommand, Mode=OneWay}" />
                </StackPanel>
                <Expander Header="Advanced" Margin="0,8,0,0">
                            <TreeView x:Name="FolderTree" />
                        </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
