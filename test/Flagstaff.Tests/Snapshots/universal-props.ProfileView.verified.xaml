<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="PropsApp.ProfileView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PropsApp"
    xmlns:vm="using:PropsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <StackPanel Spacing="8" x:Name="ProfileForm" Width="480" HorizontalAlignment="Left" ToolTipService.ToolTip="Profile form">
                    <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Full name" Description="As on your ID" IsReadOnly="True" />
                    <TextBox Header="Bio" Text="{x:Bind ViewModel.Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" ToolTipService.ToolTip="Shown publicly" PlaceholderText="A few words" />
                    <NumberBox Header="Age" Value="{x:Bind ViewModel.Age, Mode=TwoWay}" SpinButtonPlacementMode="Compact" PlaceholderText="Age" Minimum="0" Maximum="130" SmallChange="1" />
                    <NumberBox Header="Rating" Value="{x:Bind ViewModel.Rating, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0.5" Maximum="5" SmallChange="0.5" />
                    <CalendarDatePicker Header="Born" Date="{x:Bind ViewModel.Born, Mode=TwoWay}" Description="Optional" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Border Height="16" />
                    <TextBlock Text="Saved" Visibility="{x:Bind ViewModel.IsSaved, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Right" />
                    <Border Style="{StaticResource FlagstaffStatCardSuccess}" Width="200">
                        <StackPanel Spacing="4" Padding="16">
                            <TextBlock Text="Score" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Score, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="1">
                            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" Style="{StaticResource FlagstaffDangerButton}" HorizontalAlignment="Right" ToolTipService.ToolTip="Cannot be undone" />
                        </Border>
                    </Grid>
                    <CheckBox Content="Subscribe" IsChecked="{x:Bind ViewModel.Subscribe, Mode=TwoWay}" x:Name="SubscribeBox" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
