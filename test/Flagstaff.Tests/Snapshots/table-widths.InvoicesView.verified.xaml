<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="WidthsApp.InvoicesView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WidthsApp"
    xmlns:vm="using:WidthsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ListView ItemsSource="{x:Bind ViewModel.Invoices, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffTableItemContainer}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource FlagstaffTableHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Client" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Rate" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Hours" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Amount" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Invoice">
                            <Grid Style="{StaticResource FlagstaffTableRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Client}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Rate, Converter={StaticResource NumberConverter}, ConverterParameter=F2}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Hours, Converter={StaticResource NumberConverter}}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
