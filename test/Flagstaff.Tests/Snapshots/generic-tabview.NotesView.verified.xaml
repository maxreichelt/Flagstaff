<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="NotesApp.NotesView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NotesApp"
    xmlns:vm="using:NotesApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <TabView SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=TwoWay}" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
                    <TabViewItem Header="Today" IsClosable="False">
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Calendar" />
                        </TabViewItem.IconSource>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Today" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Slider Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Minimum="0" Maximum="100" Orientation="Horizontal" Margin="0,8,0,0" />
                            <TextBlock Text="Pick a date:" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.Due, Mode=TwoWay}" PlaceholderText="Due date" />
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="{x:Bind ViewModel.DraftTitle, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind ViewModel.HasDraft, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Border Padding="12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Draft, Mode=OneWay}" TextWrapping="Wrap" />
                        </Border>
                    </TabViewItem>
                </TabView>
                <Button Content="Settings" Click="OnNavigate_1" x:Name="FlagstaffLoad_1" x:Load="{x:Bind ViewModel.ShowSettings, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
