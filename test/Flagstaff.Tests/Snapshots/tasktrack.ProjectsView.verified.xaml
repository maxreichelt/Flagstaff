<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="TaskTrack.ProjectsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTrack"
    xmlns:vm="using:TaskTrack.ViewModels"
    Loaded="OnViewLoaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Library" />
                    <TextBlock Text="Projects" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <Grid RowSpacing="16" Padding="24" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectCard">
                                        <StackPanel Spacing="4" Padding="0,8">
                                            <Border Style="{StaticResource FlagstaffCard}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Owner}" />
                                                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind OpenCount}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="No projects yet." Style="{StaticResource FlagstaffEmptyState}" Grid.Row="1" Visibility="{x:Bind local:Converters.IsZero(ViewModel.Projects.Count), Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel Spacing="4" Visibility="{x:Bind local:ProjectsView.When_1(ViewModel.Selected), Mode=OneWay}">
                            <TextBlock Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Style="{StaticResource FlagstaffCard}" x:Name="HintCard" x:Load="{x:Bind ViewModel.ShowHint, Mode=OneWay}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Help" />
                                        <TextBlock Text="Tip" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Pick a project on the left. A red badge next to its name counts overdue tasks." />
                                    <Button Content="Got it" Command="{x:Bind ViewModel.DismissHintCommand, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <InfoBadge Value="{x:Bind ViewModel.SelectedOverdue, Mode=OneWay}" Visibility="{x:Bind local:ProjectsView.When_2(ViewModel.SelectedOverdue), Mode=OneWay}" Background="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Owner" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedOwner, Mode=OneWay}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Open tasks" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedOpen, Mode=OneWay}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Done" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDone, Mode=OneWay}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Progress" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedProgress, Mode=OneWay, Converter={StaticResource PercentConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                            <ProgressBar Value="{x:Bind ViewModel.SelectedPercent, Mode=OneWay}" />
                            <InfoBar IsOpen="True" Severity="Warning" Message="This project has overdue tasks." Visibility="{x:Bind local:ProjectsView.When_3(ViewModel.SelectedOverdue), Mode=OneWay}">
                                <Button Content="Review tasks" Tag="TasksView" Click="OnNavigateButtonClick" />
                            </InfoBar>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
