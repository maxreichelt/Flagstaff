<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="ShellApp.ShellView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShellApp"
    xmlns:vm="using:ShellApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="900" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="Nav.DisplayMode" Value="Inline" />
                                    <Setter Target="Nav.IsPaneOpen" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <SplitView DisplayMode="Overlay" IsPaneOpen="{x:Bind ViewModel.PaneOpen, Mode=TwoWay}" OpenPaneLength="280" x:Name="Nav">
                        <SplitView.Pane>
                            <StackPanel Padding="12">
                                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" x:Name="SaveButton" />
                            </StackPanel>
                        </SplitView.Pane>
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="Search" x:Name="Query" />
                            <TextBlock Text="{x:Bind Query.Text, Mode=OneWay}" Margin="24" />
                        </StackPanel>
                    </SplitView>
                    <TeachingTip Target="{x:Bind SaveButton}" Title="Saved" Subtitle="Your changes are stored." IsOpen="{x:Bind ViewModel.ShowTip, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
