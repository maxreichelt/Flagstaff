<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="ProjectsApp.ProjectsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectsApp"
    xmlns:vm="using:ProjectsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ListView ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Project">
                            <StackPanel Spacing="4" Padding="0,8">
                                <Expander Header="{x:Bind Name}" IsExpanded="{x:Bind IsOpen}">
                                    <TextBlock Text="{x:Bind Notes}" />
                                </Expander>
                                <Button Content="Open" Command="{Binding ElementName=FlagstaffPage, Path=ViewModel.OpenCommand}" CommandParameter="{x:Bind}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
