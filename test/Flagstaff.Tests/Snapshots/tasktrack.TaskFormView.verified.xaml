<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="TaskTrack.TaskFormView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTrack"
    xmlns:vm="using:TaskTrack.ViewModels"
    Loaded="OnViewLoaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="New Task" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Tag="TasksView" Click="OnNavigateButtonClick" />
                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind local:TaskFormView.Enabled_1(ViewModel.Title), Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <StackPanel Spacing="8" Width="720" HorizontalAlignment="Left">
                    <TextBox Header="Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What needs doing?" Description="Required" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <ComboBox Header="Project" SelectedItem="{x:Bind ViewModel.Project, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ProjectOptions, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="1">
                            <ComboBox Header="Status" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}">
                                <x:String>Open</x:String>
                                <x:String>In Progress</x:String>
                                <x:String>Done</x:String>
                            </ComboBox>
                        </Border>
                        <Border Grid.Column="2">
                            <ComboBox Header="Priority" SelectedItem="{x:Bind ViewModel.Priority, Mode=TwoWay}">
                                <x:String>Low</x:String>
                                <x:String>Medium</x:String>
                                <x:String>High</x:String>
                            </ComboBox>
                        </Border>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <TextBox Header="Assignee" Text="{x:Bind ViewModel.Assignee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Unassigned" IsReadOnly="True" />
                        </Border>
                        <Border Grid.Column="1">
                            <CalendarDatePicker Header="Due date" Date="{x:Bind ViewModel.DueDate, Mode=TwoWay}" Description="Defaults to a week from today" />
                        </Border>
                        <Border Grid.Column="2">
                            <NumberBox Header="Estimate (hours)" Value="{x:Bind ViewModel.EstimateHours, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="200" SmallChange="0.5" />
                        </Border>
                    </Grid>
                    <Button Command="{x:Bind ViewModel.OpenPickerCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="People" />
                            <TextBlock Text="Pick assignee..." />
                        </StackPanel>
                    </Button>
                    <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" PlaceholderText="Context, links, acceptance criteria" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <CheckBox Content="Blocked" IsChecked="{x:Bind ViewModel.IsBlocked, Mode=TwoWay}" />
                        </Border>
                        <Border Grid.Column="1">
                            <ToggleSwitch Header="Notify assignee" IsOn="{x:Bind ViewModel.NotifyAssignee, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                </StackPanel>
                <!-- dialog "Pick assignee": rendered in FlagstaffOverlay -->
                <!-- toast "Task saved.": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsPickerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Pick assignee" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Who should own this task?" TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <ComboBox Header="Person" SelectedItem="{x:Bind ViewModel.PickedPerson, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelIsPickerOpenCommand, Mode=OneWay}" />
                            <Button Content="Assign" Command="{x:Bind ViewModel.AssignCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.ShowSavedToast, Mode=TwoWay}" Severity="Success" Message="Task saved." IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
