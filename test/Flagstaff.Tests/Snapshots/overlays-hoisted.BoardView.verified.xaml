<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="HoistApp.BoardView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HoistApp"
    xmlns:vm="using:HoistApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Board" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Rename" Command="{x:Bind ViewModel.OpenRenameCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Border Style="{StaticResource FlagstaffCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Tasks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Overlays written inside cards and groups render in the page overlay layer." />
                        <!-- toast "Task archived.": rendered in FlagstaffOverlay -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Danger zone" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button Content="Delete all" Command="{x:Bind ViewModel.RequestDeleteAllCommand, Mode=OneWay}" />
                            <!-- confirm "Delete all tasks?": rendered in FlagstaffOverlay -->
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <!-- dialog "Rename board": rendered in FlagstaffOverlay -->
                    <!-- toast "Board renamed.": rendered in FlagstaffOverlay -->
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsDeleteAllVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Delete all tasks?" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="This removes every task." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Delete" Style="{StaticResource FlagstaffDangerButton}" Command="{x:Bind ViewModel.DeleteAllCommand, Mode=OneWay}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelIsDeleteAllVisibleCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.IsRenameVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Rename board" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBox Header="Name" Text="{x:Bind ViewModel.BoardName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelRenameCommand, Mode=OneWay}" />
                            <Button Content="Save" Command="{x:Bind ViewModel.SaveNameCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.ShowArchivedToast, Mode=TwoWay}" Severity="Informational" Message="Task archived." IsClosable="True" />
                <InfoBar IsOpen="{x:Bind ViewModel.ShowRenamedToast, Mode=TwoWay}" Severity="Success" Message="Board renamed." IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
