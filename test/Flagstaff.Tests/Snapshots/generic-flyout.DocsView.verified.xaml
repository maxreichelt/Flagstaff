<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="DocsApp.DocsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DocsApp"
    xmlns:vm="using:DocsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Button Content="More" AutomationProperties.Name="More actions" Margin="0,8,0,0">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Duplicate" Command="{x:Bind ViewModel.DuplicateCommand, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Archive" Command="{x:Bind ViewModel.ArchiveCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanArchive, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="Pinned" IsChecked="{x:Bind ViewModel.IsPinned, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <AppBarButton Label="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Save" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Undo" Icon="Undo" Command="{x:Bind ViewModel.UndoCommand, Mode=OneWay}" />
                    <TextBlock Text="Saved" Visibility="{x:Bind ViewModel.IsSaved, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
