<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="MinimalApp.HomeView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinimalApp"
    xmlns:vm="using:MinimalApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Home" />
                    <TextBlock Text="Welcome" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <TextBlock Text="Hello from Flagstaff." />
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
