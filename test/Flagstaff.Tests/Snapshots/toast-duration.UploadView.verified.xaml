<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="ToastApp.UploadView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToastApp"
    xmlns:vm="using:ToastApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Button Content="Upload" Command="{x:Bind ViewModel.UploadCommand, Mode=OneWay}" />
                <!-- toast "Uploaded.": rendered in FlagstaffOverlay -->
                <!-- toast "Upload failed.": rendered in FlagstaffOverlay -->
                <!-- toast "Retrying...": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.ShowUploadedToast, Mode=TwoWay}" Severity="Success" Message="Uploaded." IsClosable="True" />
                <InfoBar IsOpen="{x:Bind ViewModel.ShowFailedToast, Mode=TwoWay}" Severity="Error" Message="Upload failed." IsClosable="True" />
                <InfoBar IsOpen="{x:Bind ViewModel.ShowRetryToast, Mode=TwoWay}" Severity="Warning" Message="Retrying..." IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
