<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="SettingsApp.SettingsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SettingsApp"
    xmlns:vm="using:SettingsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Expander Header="Advanced" IsExpanded="{x:Bind ViewModel.ShowAdvanced, Mode=TwoWay}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="Telemetry" IsOn="{x:Bind ViewModel.Telemetry, Mode=TwoWay}" />
                        <Slider Header="Cache size (MB)" Minimum="64" Maximum="2048" Value="{x:Bind ViewModel.CacheMb, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>
                <TabView>
                    <TabViewItem Header="General" IsClosable="False">
                        <TextBox Header="Display name" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabViewItem>
                    <TabViewItem Header="Account" IsClosable="False">
                        <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand, Mode=OneWay}" Style="{StaticResource FlagstaffDangerButton}" />
                    </TabViewItem>
                </TabView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
