<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="DashboardApp.ReportsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DashboardApp"
    xmlns:vm="using:DashboardApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Document" />
                    <TextBlock Text="Reports" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <InfoBar IsOpen="True" Severity="Informational" Message="Report data is more than a day old." Visibility="{x:Bind ViewModel.IsStale, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Back to overview" Tag="OverviewView" Click="OnNavigateButtonClick" />
                </InfoBar>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
