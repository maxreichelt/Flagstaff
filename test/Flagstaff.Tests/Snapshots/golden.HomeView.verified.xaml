<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="TestApp.HomeView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TestApp"
    xmlns:vm="using:TestApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Home" />
                    <TextBlock Text="Home" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedItem="{x:Bind ViewModel.Year, Mode=TwoWay}">
                    <x:Int32>2019</x:Int32>
                    <x:Int32>2020</x:Int32>
                    <x:Int32>2021</x:Int32>
                    <x:Int32>2022</x:Int32>
                    <x:Int32>2023</x:Int32>
                    <x:Int32>2024</x:Int32>
                    <x:Int32>2025</x:Int32>
                    <x:Int32>2026</x:Int32>
                </ComboBox>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCard}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Pending" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardDanger}" Visibility="{x:Bind local:HomeView.When_1(ViewModel.AlertCount), Mode=OneWay}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Alerts" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AlertCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
                <Border Style="{StaticResource FlagstaffCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Summary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Total" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Net" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NetTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBox Header="Name" Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Active" IsChecked="{x:Bind ViewModel.IsActive, Mode=TwoWay}" />
                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" />
                <InfoBar IsOpen="True" Severity="Warning" Message="Something needs attention." Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                </InfoBar>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
