<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="EventsApp.OrdersView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EventsApp"
    xmlns:vm="using:EventsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ComboBox Header="Status" SelectionChanged="OnEvent_1" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Statuses, Mode=OneWay}" />
                <ComboBox Header="Owner" SelectionChanged="OnEvent_2" SelectedItem="{x:Bind ViewModel.Owner, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Owners, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:Person">
                            <TextBlock Text="{x:Bind}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" ItemClick="OnEvent_3" IsItemClickEnabled="True" />
                <ListView ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}" ItemContainerStyle="{StaticResource FlagstaffListItemContainer}" SelectionChanged="OnEvent_4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Order">
                            <StackPanel Spacing="4" Padding="0,8">
                                <TextBlock Text="{x:Bind Number}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
