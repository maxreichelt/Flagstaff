<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="OverlaysApp.ItemsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OverlaysApp"
    xmlns:vm="using:OverlaysApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <InfoBar IsOpen="True" Severity="Warning" Message="Some items are low on stock." Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                </InfoBar>
                <InfoBar IsOpen="True" Severity="Error" Message="Sync failed." Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
                </InfoBar>
                <InfoBar IsOpen="True" Severity="Informational" Message="New items were imported." Visibility="{x:Bind ViewModel.HasInfo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                </InfoBar>
                <InfoBar IsOpen="True" Severity="Success" Message="All items synced." Visibility="{x:Bind ViewModel.IsSynced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                </InfoBar>
                <!-- toast "Item saved.": rendered in FlagstaffOverlay -->
                <!-- toast "Upload failed.": rendered in FlagstaffOverlay -->
                <Button Content="Delete" Command="{x:Bind ViewModel.RequestDeleteCommand, Mode=OneWay}" />
                <!-- confirm "Delete item?": rendered in FlagstaffOverlay -->
                <!-- confirm "Rename item": rendered in FlagstaffOverlay -->
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FlagstaffOverlay" Grid.Row="0" Grid.RowSpan="2">
            <Grid Visibility="{x:Bind ViewModel.IsDeleteVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Delete item?" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="This cannot be undone." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelDeleteCommand, Mode=OneWay}" />
                            <Button Content="Delete" Command="{x:Bind ViewModel.ConfirmDeleteCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.IsRenameVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource FlagstaffDialogBackdrop}" />
                <Border Style="{StaticResource FlagstaffDialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Rename item" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Choose a new name and category." TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <TextBox Header="Name" Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Header="Category" SelectedItem="{x:Bind ViewModel.NewCategory, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" />
                            <CheckBox Content="Keep history" IsChecked="{x:Bind ViewModel.KeepHistory, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelRenameCommand, Mode=OneWay}" />
                            <Button Content="Rename" Command="{x:Bind ViewModel.ConfirmRenameCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.ShowSavedToast, Mode=TwoWay}" Severity="Success" Message="Item saved." IsClosable="True" />
                <InfoBar IsOpen="{x:Bind ViewModel.ShowErrorToast, Mode=TwoWay}" Severity="Error" Message="Upload failed." IsClosable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
