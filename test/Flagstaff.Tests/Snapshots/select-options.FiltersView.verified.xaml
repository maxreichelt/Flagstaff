<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="SelectApp.FiltersView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelectApp"
    xmlns:vm="using:SelectApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ComboBox Header="Status" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}">
                    <x:String>Open</x:String>
                    <x:String>Closed</x:String>
                    <x:String>On hold</x:String>
                </ComboBox>
                <ComboBox Header="Year" SelectedItem="{x:Bind ViewModel.Year, Mode=TwoWay}">
                    <x:Int32>2024</x:Int32>
                    <x:Int32>2025</x:Int32>
                    <x:Int32>2026</x:Int32>
                </ComboBox>
                <ComboBox Header="Vendor" SelectedItem="{x:Bind ViewModel.Vendor, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Vendors, Mode=OneWay}" DisplayMemberPath="Name" />
                <ComboBox Header="Owner" SelectedItem="{x:Bind ViewModel.Owner, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Owners, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:Person">
                            <TextBlock Text="{x:Bind}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
