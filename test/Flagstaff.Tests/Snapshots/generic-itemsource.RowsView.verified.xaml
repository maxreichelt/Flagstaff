<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="RowsApp.RowsView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RowsApp"
    xmlns:vm="using:RowsApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionChanged="OnEvent_1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" />
                                <CheckBox Content="Done" IsChecked="{x:Bind IsDone, Mode=TwoWay}" />
                                <Button Content="Open" Command="{Binding ElementName=FlagstaffPage, Path=ViewModel.OpenCommand}" CommandParameter="{x:Bind}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <GridView ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
