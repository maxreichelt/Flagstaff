<!-- Auto-generated by Flagstaff — overwritten on next flagstaff compile. -->
<Page
    x:Class="DashboardApp.OverviewView"
    x:Name="FlagstaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DashboardApp"
    xmlns:vm="using:DashboardApp.ViewModels"
    Loaded="OnViewLoaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource FlagstaffToolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Home" />
                    <TextBlock Text="Overview" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedItem="{x:Bind ViewModel.Year, Mode=TwoWay}">
                    <x:Int32>2020</x:Int32>
                    <x:Int32>2021</x:Int32>
                    <x:Int32>2022</x:Int32>
                    <x:Int32>2023</x:Int32>
                    <x:Int32>2024</x:Int32>
                    <x:Int32>2025</x:Int32>
                    <x:Int32>2026</x:Int32>
                </ComboBox>
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="24">
                <InfoBar IsOpen="True" Severity="Error" Message="Overdue invoices need attention." Visibility="{x:Bind ViewModel.HasOverdue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="View reports" Tag="ReportsView" Click="OnNavigateButtonClick" />
                </InfoBar>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCard}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OpenCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardWarning}" Visibility="{x:Bind local:OverviewView.When_1(ViewModel.PendingCount), Mode=OneWay}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Pending" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardDanger}" Visibility="{x:Bind local:OverviewView.When_2(ViewModel.OverdueCount), Mode=OneWay}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Overdue" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OverdueCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.Column="3" Grid.Row="0">
                        <Border Style="{StaticResource FlagstaffStatCardSuccess}" Visibility="{x:Bind local:OverviewView.When_3(ViewModel.ClosedCount), Mode=OneWay}">
                            <StackPanel Spacing="4" Padding="16">
                                <TextBlock Text="Closed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ClosedCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
                <Border Style="{StaticResource FlagstaffCard}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Document" />
                            <TextBlock Text="Summary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Revenue" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Revenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Expenses" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Expenses, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Margin" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Margin, Mode=OneWay, Converter={StaticResource PercentConverter}}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Net" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Net, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
